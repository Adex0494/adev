# Server-only. Set to the stable Production origin assigned to medika-demo.
# Leave empty for standalone local development; use http://localhost:3010 locally.
MEDIKA_DEMO_ORIGIN=

# Optional server-side mail delivery. Configure BOTH to enable automatic sending.
# Use a verified sender address from your Resend account. Never use NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional: a real public HTTPS Calendly event URL. Empty keeps email/form contact.
NEXT_PUBLIC_CALENDLY_URL=
